# 키는 둘 중 한 곳에만 넣으면 됩니다: 이 파일(.env) 또는 앱의 설정 창.
# .env 는 .gitignore 에 포함되어 커밋되지 않습니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 모델명은 바뀌는 속도가 빠릅니다. 404가 나면 앱 설정 창에서 '목록 불러오기'로 고르세요.
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-pro-latest
ANTHROPIC_MODEL=claude-sonnet-5-5

# PORT=3000
# HOST=127.0.0.1   # 외부 접속을 열면 서버 키를 누구나 쓸 수 있게 됩니다. 기본값 유지 권장.
# MOCK=1           # 키 없이 UI만 체험하는 데모 모드
