# [로그인(CLI) 방식]이면 이 파일은 필요 없습니다. claude / codex / gemini 를 터미널에서 한 번 로그인해 두세요.
# [API 키 방식]이면 아래 키를 넣거나 앱의 설정 창에 입력하세요. (.env 는 .gitignore 에 포함됩니다.)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 모델명은 바뀌는 속도가 빠릅니다. 404가 나면 앱 설정 창에서 '목록 불러오기'로 고르세요.
OPENAI_MODEL=gpt-5
GEMINI_MODEL=gemini-pro-latest
ANTHROPIC_MODEL=claude-sonnet-5-5

# CLI 실행 파일 경로가 PATH 에 없을 때만 지정
# CLAUDE_CMD=claude
# CODEX_CMD=codex
# GEMINI_CMD=gemini
# CLI_TIMEOUT_MS=300000   # CLI 1회 호출 제한 시간

# PORT=3000
# HOST=127.0.0.1   # 외부 접속을 열면 서버 키를 누구나 쓸 수 있게 됩니다. 기본값 유지 권장.
# MOCK=1           # 키 없이 UI만 체험하는 데모 모드
